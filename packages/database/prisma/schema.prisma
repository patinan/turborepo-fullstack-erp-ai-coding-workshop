// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Administrator, Purchasing officer, Store employee, Manager.
enum Role {
  ADMIN
  PURCHASING
  STORE_STAFF
  MANAGER
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A CHECK in the migration requires `storeId` exactly when `role` is STORE_STAFF [C-18].
model User {
  id                String    @id @default(cuid())
  /// Stored trimmed and lower-cased (a CHECK enforces it), so the unique index is case-insensitive [C-20].
  username          String    @unique
  name              String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash      String
  role              Role
  storeId           String?
  store             Store?    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  active            Boolean   @default(true)
  /// Sessions issued before this instant no longer work. Set when the user signs out.
  sessionsRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
