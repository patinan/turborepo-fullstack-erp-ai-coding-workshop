// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Administrator, Purchasing officer, Store employee, Manager.
enum Role {
  ADMIN
  PURCHASING
  STORE_STAFF
  MANAGER
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  users     User[]
  stock     StockBalance[]
  movements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A CHECK in the migration requires `storeId` exactly when `role` is STORE_STAFF [C-18].
model User {
  id                String    @id @default(cuid())
  /// Stored trimmed and lower-cased (a CHECK enforces it), so the unique index is case-insensitive [C-20].
  username          String    @unique
  name              String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash      String
  role              Role
  storeId           String?
  store             Store?    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  active            Boolean   @default(true)
  /// Sessions issued before this instant no longer work. Set when the user signs out.
  sessionsRevokedAt DateTime?
  stockMovements    StockMovement[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  category     String
  /// The single base unit the product is counted in, e.g. pack or bag.
  unit         String
  sellingPrice Decimal         @db.Decimal(12, 2)
  active       Boolean         @default(true)
  stock        StockBalance[]
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// One row per product × store (ADR-0001). A CHECK in the migration keeps `quantity` ≥ 0.
model StockBalance {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  quantity         Int      @default(0)
  /// Low stock when `quantity` ≤ this.
  reorderThreshold Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([productId, storeId])
}

enum StockMovementType {
  OPENING
  RECEIPT
  SALE
  ADJUSTMENT
}

/// The append-only ledger (ADR-0001). A trigger in the migration rejects UPDATE and DELETE.
model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  type           StockMovementType
  quantityChange Int
  balanceBefore  Int
  balanceAfter   Int
  /// The source document. Null for OPENING movements, which only fixture data writes.
  sourceType     String?
  sourceId       String?
  sourceNumber   String?
  /// Null for OPENING movements.
  actorId        String?
  actor          User?             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([productId, storeId])
}
